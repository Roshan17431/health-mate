# Replace every 192.0.2.10/32 below with the ACTUAL immediate edge source IP/CIDR
# as seen by this container. This documentation-only address is not a default.
# Keep both lists identical. Never trust 0.0.0.0/0 or all private networks.
# The edge must overwrite X-Forwarded-For and X-Forwarded-Proto itself.
set_real_ip_from 192.0.2.10/32;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
geo $realip_remote_addr $healthmate_trusted_edge {
    default 0;
    192.0.2.10/32 1;
}
map "$healthmate_trusted_edge:$http_x_forwarded_proto" $healthmate_forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
}
