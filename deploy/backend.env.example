# Store the completed file outside Git with mode 600; do not print it or bake it into an image.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db.example.com:5432/healthmate?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
DB_USERNAME=healthmate_app
DB_PASSWORD=<private-runtime-database-password>
JWT_SECRET=<base64-of-at-least-32-private-random-bytes>
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=https://care.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<private-smtp-username>
SMTP_PASSWORD=<private-smtp-password>
SMTP_FROM=Health Mate <no-reply@example.com>
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
