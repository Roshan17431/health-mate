DB_URL=jdbc:postgresql://<host>/<database>?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
DB_USERNAME=<username>
DB_PASSWORD=<password>
JWT_SECRET=<base64-encoded-secret>
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=https://care.example.com
# The production profile fixes ddl-auto=validate and SQL initialization=never.
SPRING_PROFILES_ACTIVE=prod

# Required to deliver verification/password-reset codes. Use a verified sender.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=Health Mate <no-reply@example.com>
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
